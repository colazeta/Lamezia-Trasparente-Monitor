@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://example.invalid/lt-test/act-1>
  a lt:AdministrativeAct ;
  dct:identifier "act-1" ;
  dct:title "Atto sintetico di validazione"@it ;
  prov:wasDerivedFrom <https://example.invalid/source/act-1> .

<https://example.invalid/lt-test/act-1/markdown>
  a lt:AdministrativeActTextRepresentation ;
  lt:isTextRepresentationOf <https://example.invalid/lt-test/act-1> ;
  prov:wasDerivedFrom <https://example.invalid/source/act-1> .

<https://example.invalid/lt-test/contract-record-1>
  a lt:PublicProcurementRecord ;
  dct:identifier "CIG-TEST-1" ;
  prov:wasDerivedFrom <https://example.invalid/source/contract-1> .

<https://example.invalid/lt-test/theme-1>
  a lt:CivicTheme ;
  skos:prefLabel "Tema sintetico"@it , "Synthetic theme"@en ;
  skos:inScheme <https://lamezia-trasparente.pages.dev/semantic/civic-concepts> .

<https://example.invalid/lt-test/performance-1>
  a lt:PerformanceIndicator ;
  dct:identifier "indicator-test-1" ;
  skos:prefLabel "Indicatore sintetico"@it , "Synthetic indicator"@en .

<https://example.invalid/lt-test/pnrr-1>
  a lt:PnrrProject ;
  dct:identifier "CUP-TEST-1" ;
  prov:wasDerivedFrom <https://example.invalid/source/pnrr-1> .
