@prefix lt: <https://lamezia-trasparente.pages.dev/ontology#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://lamezia-trasparente.pages.dev/semantic/shapes.ttl>
  a lt:ValidationShapeGraph ;
  dct:identifier "lt-semantic-shapes-1.2.0" ;
  dct:title "LameziaTrasparente semantic validation shapes"@en ,
    "Shape di validazione semantica di LameziaTrasparente"@it ;
  owl:versionInfo "1.2.0" .

lt:SemanticProfileShape
  a sh:NodeShape ;
  sh:targetClass lt:SemanticProfile ;
  sh:property [
    sh:path rdf:type ;
    sh:hasValue adms:SemanticAsset
  ] ;
  sh:property [
    sh:path dct:identifier ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path dct:title ;
    sh:minCount 1 ;
    sh:uniqueLang true ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path dct:description ;
    sh:minCount 1 ;
    sh:uniqueLang true ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path owl:versionInfo ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path lt:validationShapes ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:hasValue <https://lamezia-trasparente.pages.dev/semantic/shapes.ttl>
  ] ;
  sh:property [
    sh:path lt:civicConceptScheme ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:hasValue <https://lamezia-trasparente.pages.dev/semantic/civic-concepts>
  ] .

lt:ValidationShapeGraphShape
  a sh:NodeShape ;
  sh:targetNode <https://lamezia-trasparente.pages.dev/semantic/shapes.ttl> ;
  sh:class lt:ValidationShapeGraph ;
  sh:property [
    sh:path dct:identifier ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path dct:title ;
    sh:minCount 1 ;
    sh:uniqueLang true ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path owl:versionInfo ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal
  ] .

lt:CivicConceptSchemeShape
  a sh:NodeShape ;
  sh:targetNode <https://lamezia-trasparente.pages.dev/semantic/civic-concepts> ;
  sh:class skos:ConceptScheme ;
  sh:property [
    sh:path dct:identifier ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path dct:title ;
    sh:minCount 1 ;
    sh:uniqueLang true ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path owl:versionInfo ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path skos:hasTopConcept ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI
  ] .

lt:GovernedCivicConceptShape
  a sh:NodeShape ;
  sh:targetClass skos:Concept ;
  sh:property [
    sh:path skos:notation ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path skos:prefLabel ;
    sh:minCount 2 ;
    sh:uniqueLang true ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path skos:prefLabel ;
    sh:qualifiedValueShape [ sh:languageIn ( "it" ) ] ;
    sh:qualifiedMinCount 1
  ] ;
  sh:property [
    sh:path skos:prefLabel ;
    sh:qualifiedValueShape [ sh:languageIn ( "en" ) ] ;
    sh:qualifiedMinCount 1
  ] ;
  sh:property [
    sh:path skos:inScheme ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:hasValue <https://lamezia-trasparente.pages.dev/semantic/civic-concepts>
  ] .

lt:AdministrativeActShape
  a sh:NodeShape ;
  sh:targetClass lt:AdministrativeAct ;
  sh:property [
    sh:path dct:identifier ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path dct:title ;
    sh:minCount 1 ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path prov:wasDerivedFrom ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI
  ] .

lt:AdministrativeActTextRepresentationShape
  a sh:NodeShape ;
  sh:targetClass lt:AdministrativeActTextRepresentation ;
  sh:property [
    sh:path lt:isTextRepresentationOf ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class lt:AdministrativeAct
  ] ;
  sh:property [
    sh:path prov:wasDerivedFrom ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI
  ] .

lt:PublicProcurementRecordShape
  a sh:NodeShape ;
  sh:targetClass lt:PublicProcurementRecord ;
  sh:property [
    sh:path dct:identifier ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path prov:wasDerivedFrom ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI
  ] .

lt:CivicThemeShape
  a sh:NodeShape ;
  sh:targetClass lt:CivicTheme ;
  sh:property [
    sh:path skos:prefLabel ;
    sh:minCount 1 ;
    sh:uniqueLang true ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path skos:inScheme ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] .

lt:PerformanceIndicatorShape
  a sh:NodeShape ;
  sh:targetClass lt:PerformanceIndicator ;
  sh:property [
    sh:path dct:identifier ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path skos:prefLabel ;
    sh:minCount 1 ;
    sh:uniqueLang true ;
    sh:nodeKind sh:Literal
  ] .

lt:PnrrProjectShape
  a sh:NodeShape ;
  sh:targetClass lt:PnrrProject ;
  sh:property [
    sh:path dct:identifier ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path prov:wasDerivedFrom ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI
  ] .
