  sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .

lt:PolicyInterventionModelShape a sh:NodeShape ;
  sh:targetClass lt:PolicyIntervention ;
  sh:property [ sh:path dct:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .

lt:SourceAssertionModelShape a sh:NodeShape ;
  sh:targetClass lt:SourceAssertion ;
  sh:property [ sh:path dct:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .

lt:ResolutionOutcomeModelShape a sh:NodeShape ;
  sh:targetClass lt:ResolutionOutcome ;
  sh:property [ sh:path dct:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path lt:resolutionStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "resolved" "unresolved" "not_applicable" "no_canonical_target" "insufficient_evidence" "review_required" ) ] ;
  sh:xone ( [ sh:property [ sh:path lt:resolutionStatus ; sh:hasValue "resolved" ] ; sh:property [ sh:path lt:resolvedSubject ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lt:CanonicalSubject ] ] [ sh:property [ sh:path lt:resolutionStatus ; sh:not [ sh:in ( "resolved" ) ] ] ; sh:property [ sh:path lt:resolvedSubject ; sh:maxCount 0 ] ] ) .

lt:QualifiedIdentifierModelShape a sh:NodeShape ;
  sh:targetClass lt:QualifiedIdentifier ;
  sh:property [ sh:path dct:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .

lt:ProcurementLotModelShape a sh:NodeShape ;
  sh:targetClass lt:ProcurementLot ;
  sh:property [ sh:path dct:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path lt:subjectKind ; sh:hasValue "entity" ] ;
  sh:property [ sh:path lt:domainType ; sh:hasValue "procurement.lot" ] ;
  sh:not [ sh:class lt:ProcurementProcedure ] ;
  sh:not [ sh:class lt:ProcurementContract ] ;
  sh:not [ sh:class lt:ProcurementMention ] ;
  sh:not [ sh:class lt:ProcurementFinancialEvent ] .

lt:ProcurementMentionModelShape a sh:NodeShape ;
  sh:targetClass lt:ProcurementMention ;
  sh:property [ sh:path dct:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:not [ sh:class lt:ProcurementProcedure ] ;
  sh:not [ sh:class lt:ProcurementLot ] ;
  sh:not [ sh:class lt:ProcurementContract ] ;
  sh:not [ sh:class lt:ProcurementFinancialEvent ] ;
  sh:property [ sh:path lt:describesContract ; sh:maxCount 0 ] .

lt:ProcurementFinancialEventModelShape a sh:NodeShape ;
  sh:targetClass lt:ProcurementFinancialEvent ;
  sh:property [ sh:path dct:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path lt:subjectKind ; sh:hasValue "event" ] ;
  sh:property [ sh:path lt:domainType ; sh:hasValue "procurement.financial_event" ] ;
  sh:not [ sh:class lt:ProcurementProcedure ] ;
  sh:not [ sh:class lt:ProcurementLot ] ;
  sh:not [ sh:class lt:ProcurementContract ] ;
  sh:not [ sh:class lt:ProcurementMention ] .

lt:PublicationVersionModelShape a sh:NodeShape ;
  sh:targetClass lt:PublicationVersion ;
  sh:property [ sh:path dct:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path lt:publicationVisibility ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "publishable" "metadata_only" "do_not_publish" ) ] ;
  sh:or ( [ sh:property [ sh:path lt:publicationVisibility ; sh:hasValue "publishable" ] ; sh:property [ sh:path lt:publicationPolicyVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ] [ sh:property [ sh:path lt:publicationVisibility ; sh:not [ sh:in ( "publishable" ) ] ] ; sh:property [ sh:path dct:title ; sh:maxCount 0 ] ] ) .

lt:TaxonomySchemeModelShape a sh:NodeShape ;
  sh:targetClass lt:TaxonomyScheme ;
  sh:property [ sh:path dct:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] .

lt:ClassificationAssignmentModelShape a sh:NodeShape ;
  sh:targetClass lt:ClassificationAssignment ;
  sh:property [ sh:path dct:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path lt:classificationStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "classified" "unknown" "not_applicable" "insufficient_evidence" "review_required" ) ] ;
  sh:property [ sh:path lt:classificationMethod ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path lt:classificationFacet ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:xone ( [ sh:property [ sh:path lt:classificationStatus ; sh:hasValue "classified" ] ; sh:property [ sh:path lt:assignedConcept ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lt:TaxonomyConcept ] ] [ sh:property [ sh:path lt:classificationStatus ; sh:not [ sh:in ( "classified" ) ] ] ; sh:property [ sh:path lt:assignedConcept ; sh:maxCount 0 ] ] ) .

