@prefix lt: <https://lamezia-trasparente.pages.dev/ontology#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<https://lamezia-trasparente.pages.dev/semantic/shapes.ttl>
  a lt:ValidationShapeGraph ;
  dct:identifier "lt-semantic-shapes-1.3.0" ;
  dct:title "LameziaTrasparente semantic validation shapes"@en ,
    "Shape di validazione semantica di LameziaTrasparente"@it ;
  owl:versionInfo "1.3.0" .

lt:SemanticProfileShape
  a sh:NodeShape ;
  sh:targetClass lt:SemanticProfile ;
  sh:property [
    sh:path rdf:type ;
    sh:hasValue adms:SemanticAsset
  ] ;
  sh:property [
    sh:path dct:identifier ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path dct:title ;
    sh:minCount 1 ;
    sh:uniqueLang true ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path dct:description ;
    sh:minCount 1 ;
    sh:uniqueLang true ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path owl:versionInfo ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path lt:validationShapes ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:hasValue <https://lamezia-trasparente.pages.dev/semantic/shapes.ttl>
  ] ;
  sh:property [
    sh:path lt:civicConceptScheme ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:hasValue <https://lamezia-trasparente.pages.dev/semantic/civic-concepts>
  ] .

lt:ValidationShapeGraphShape
  a sh:NodeShape ;
  sh:targetNode <https://lamezia-trasparente.pages.dev/semantic/shapes.ttl> ;
  sh:class lt:ValidationShapeGraph ;
  sh:property [
    sh:path dct:identifier ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path dct:title ;
    sh:minCount 1 ;
    sh:uniqueLang true ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path owl:versionInfo ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal
  ] .

lt:CivicConceptSchemeShape
  a sh:NodeShape ;
  sh:targetNode <https://lamezia-trasparente.pages.dev/semantic/civic-concepts> ;
  sh:class skos:ConceptScheme ;
  sh:property [
    sh:path dct:identifier ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path dct:title ;
    sh:minCount 1 ;
    sh:uniqueLang true ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path owl:versionInfo ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path skos:hasTopConcept ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI
  ] .

lt:GovernedCivicConceptShape
  a sh:NodeShape ;
  sh:targetNode <https://lamezia-trasparente.pages.dev/concept/acts> ,
    <https://lamezia-trasparente.pages.dev/concept/governance> ,
    <https://lamezia-trasparente.pages.dev/concept/spending> ,
    <https://lamezia-trasparente.pages.dev/concept/territory> ,
    <https://lamezia-trasparente.pages.dev/concept/integrity> ,
    <https://lamezia-trasparente.pages.dev/concept/open-data> ,
    <https://lamezia-trasparente.pages.dev/concept/participation> ;
  sh:class skos:Concept ;
  sh:property [
    sh:path skos:notation ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path skos:prefLabel ;
    sh:minCount 2 ;
    sh:uniqueLang true ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path skos:prefLabel ;
    sh:qualifiedValueShape [ sh:languageIn ( "it" ) ] ;
    sh:qualifiedMinCount 1
  ] ;
  sh:property [
    sh:path skos:prefLabel ;
    sh:qualifiedValueShape [ sh:languageIn ( "en" ) ] ;
    sh:qualifiedMinCount 1
  ] ;
  sh:property [
    sh:path skos:inScheme ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:hasValue <https://lamezia-trasparente.pages.dev/semantic/civic-concepts>
  ] .

lt:AdministrativeActShape
  a sh:NodeShape ;
  sh:targetClass lt:AdministrativeAct ;
  sh:property [
    sh:path dct:identifier ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path dct:title ;
    sh:minCount 1 ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path prov:wasDerivedFrom ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI
  ] .

lt:AdministrativeActTextRepresentationShape
  a sh:NodeShape ;
  sh:targetClass lt:AdministrativeActTextRepresentation ;
  sh:property [
    sh:path lt:isTextRepresentationOf ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class lt:AdministrativeAct
  ] ;
  sh:property [
    sh:path prov:wasDerivedFrom ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI
  ] .

lt:PublicProcurementRecordShape
  a sh:NodeShape ;
  sh:targetClass lt:PublicProcurementRecord ;
  sh:property [
    sh:path dct:identifier ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path prov:wasDerivedFrom ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI
  ] .

lt:CivicThemeShape
  a sh:NodeShape ;
  sh:targetClass lt:CivicTheme ;
  sh:property [
    sh:path skos:prefLabel ;
    sh:minCount 1 ;
    sh:uniqueLang true ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path skos:inScheme ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] .

lt:PerformanceIndicatorShape
  a sh:NodeShape ;
  sh:targetClass lt:PerformanceIndicator ;
  sh:property [
    sh:path dct:identifier ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path skos:prefLabel ;
    sh:minCount 1 ;
    sh:uniqueLang true ;
    sh:nodeKind sh:Literal
  ] .

lt:PnrrProjectShape
  a sh:NodeShape ;
  sh:targetClass lt:PnrrProject ;
  sh:property [
    sh:path dct:identifier ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal
  ] ;
  sh:property [
    sh:path prov:wasDerivedFrom ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI
  ] .

@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Generated from architecture/data-domain-registry.v1.json. Run node scripts/semantic/generate-model.mjs --write.
lt:CanonicalSubjectModelShape a sh:NodeShape ;
  sh:targetClass lt:CanonicalSubject ;
  sh:property [ sh:path dct:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path dct:identifier ; sh:pattern "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" ] ;
  sh:property [ sh:path lt:subjectKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "entity" "event" ) ] ;
  sh:property [ sh:path lt:domainType ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] .

lt:InformationSourceModelShape a sh:NodeShape ;
  sh:targetClass lt:InformationSource ;
  sh:property [ sh:path dct:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] .

lt:SourceArtifactModelShape a sh:NodeShape ;
  sh:targetClass lt:SourceArtifact ;
  sh:property [ sh:path dct:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .

lt:SourceReleaseModelShape a sh:NodeShape ;
  sh:targetClass lt:SourceRelease ;
  sh:property [ sh:path dct:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .

lt:SourceRecordModelShape a sh:NodeShape ;
  sh:targetClass lt:SourceRecord ;
  sh:property [ sh:path dct:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .

lt:AcquisitionRunModelShape a sh:NodeShape ;
  sh:targetClass lt:AcquisitionRun ;
  sh:property [ sh:path dct:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .

lt:PublicationEventModelShape a sh:NodeShape ;
  sh:targetClass lt:PublicationEvent ;
  sh:property [ sh:path dct:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path lt:subjectKind ; sh:hasValue "event" ] ;
  sh:property [ sh:path lt:domainType ; sh:hasValue "document.publication" ] ;
  sh:not [ sh:class lt:AdministrativeDecision ] ;
  sh:not [ sh:class lt:DocumentResource ] .

lt:DocumentResourceModelShape a sh:NodeShape ;
  sh:targetClass lt:DocumentResource ;
  sh:property [ sh:path dct:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path lt:subjectKind ; sh:hasValue "entity" ] ;
  sh:property [ sh:path lt:domainType ; sh:hasValue "document.document" ] ;
  sh:not [ sh:class lt:PublicationEvent ] ;
  sh:not [ sh:class lt:AdministrativeDecision ] .

lt:AdministrativeDecisionModelShape a sh:NodeShape ;
  sh:targetClass lt:AdministrativeDecision ;
  sh:property [ sh:path dct:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path lt:subjectKind ; sh:hasValue "entity" ] ;
  sh:property [ sh:path lt:domainType ; sh:hasValue "document.act" ] ;
  sh:not [ sh:class lt:PublicationEvent ] ;
  sh:not [ sh:class lt:DocumentResource ] .

