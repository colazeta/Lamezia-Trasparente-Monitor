  "dct:identifier": "lt-semantic-profile-1.2.0",
  "owl:versionInfo": "1.2.0",
  "dct:title": [
    {
      "@value": "LameziaTrasparente civic semantic profile",
      "@language": "en"
    },
    {
      "@value": "Profilo semantico civico di LameziaTrasparente",
      "@language": "it"
    }
  ],
  "dct:description": [
    {
      "@value": "Versioned semantic alignment for LameziaTrasparente public-safe civic data. It distinguishes validated conformance targets from ontology references and domain alignments; it does not assert OWL equivalence where the source data model is narrower than the external ontology. SHACL shapes define local validation invariants and a SKOS concept scheme provides stable civic classification identifiers.",
      "@language": "en"
    },
    {
      "@value": "Allineamento semantico versionato per i dati civici public-safe di LameziaTrasparente. Distingue gli obiettivi di conformità validabile dai riferimenti ontologici e dagli allineamenti di dominio; non dichiara equivalenza OWL quando il modello sorgente è più ristretto dell'ontologia esterna. Shape SHACL definiscono gli invarianti locali di validazione e uno schema SKOS fornisce identificatori stabili per la classificazione civica.",
      "@language": "it"
    }
  ],
  "dct:issued": {
    "@value": "2026-09-03",
    "@type": "xsd:date"
  },
