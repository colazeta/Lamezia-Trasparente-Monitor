# Cloudflare Pages canonical routes and SPA fallbacks.
# Exact public paths use a directory URL because the build emits route/index.html.
# API and feed requests are intercepted by _worker.js and must never reach the SPA.

# Legacy aliases
/bandi    /contratti/    301
/bandi/*    /contratti/    301
/archivio-proposte    /proposte-civiche/    301
/legalita/timeline    /legalita/    301
/legalita/timeline/*    /legalita/    301
/performance/confronta    /performance/    301
/performance/confronta/*    /performance/    301

# Nested public routes must precede their parent wildcards.
/convocazioni/demo-consiglio-comunale-v0    /convocazioni/demo-consiglio-comunale-v0/    301
/convocazioni/demo-consiglio-comunale-v0/*    /index.html    200
/legalita/trame-festival    /legalita/trame-festival/    301
/legalita/trame-festival/*    /index.html    200

