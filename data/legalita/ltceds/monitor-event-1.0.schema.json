{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lameziatrasparente.it/schemas/lt-crime-monitor/1.0",
  "title": "Lamezia Trasparente crime monitor ingestion event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ingestion_schema",
    "event_key",
    "discovered_at",
    "updated_at",
    "record_status",
    "event_form",
    "title",
    "temporal",
    "sources",
    "offences",
    "locations"
  ],
  "properties": {
    "ingestion_schema": { "const": "lt-crime-monitor/1.0" },
    "event_key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9:._-]{2,179}$" },
    "discovered_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "record_status": {
      "enum": ["verified_source", "superseded", "merged", "split", "withdrawn", "suppressed"]
    },
    "event_form": { "enum": ["discrete", "continuous_episode", "course_of_conduct"] },
    "title": { "type": "string", "minLength": 3 },
    "temporal": { "$ref": "#/$defs/temporal" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "offences": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/offence" }
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/location" }
    }
  },
  "$defs": {
    "stableKey": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,179}$"
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["precision"],
      "properties": {
        "start": { "type": ["string", "null"] },
        "end": { "type": ["string", "null"] },
        "edtf": { "type": ["string", "null"] },
        "precision": {
          "enum": ["exact_datetime", "exact_date", "bounded_interval", "week_or_similar", "month", "year", "approximate", "unknown"]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_key", "source_type", "provider", "title"],
      "properties": {
        "source_key": { "$ref": "#/$defs/stableKey" },
        "source_type": {
          "enum": ["judicial_primary", "law_enforcement_primary", "public_authority_primary", "news_agency", "press_secondary", "academic", "other"]
        },
        "provider": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": ["string", "null"], "format": "uri" },
        "published_at": { "type": ["string", "null"], "format": "date-time" },
        "retrieved_at": { "type": ["string", "null"], "format": "date-time" },
        "support_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["event_support", "classification_support", "location_support", "procedural_context", "corroboration"]
          }
        }
      }
    },
    "offence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offence_key", "classification_basis"],
      "properties": {
        "offence_key": { "$ref": "#/$defs/stableKey" },
        "classification_source_key": { "anyOf": [{ "$ref": "#/$defs/stableKey" }, { "type": "null" }] },
        "classification_basis": {
          "enum": ["source_stated_legal", "istat_crosswalk", "behavioural_manual", "provisional"]
        },
        "iccs_code": { "type": ["string", "null"] },
        "istat_catalogue_id": { "type": ["string", "null"] },
        "istat_synthetic_code": { "type": ["string", "null"] },
        "istat_analytical_code": { "type": ["string", "null"] },
        "legal_reference": { "type": ["string", "null"] },
        "attempt_status": { "enum": ["attempted", "completed", "not_applicable", "unknown", null] },
        "situational_context": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "cyber_related": { "type": ["string", "null"] },
        "affected_object_count": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location_key",
        "role",
        "municipality",
        "evidence_basis",
        "evidence_precision",
        "resolved_precision",
        "sensitivity",
        "publication_risk"
      ],
      "properties": {
        "location_key": { "$ref": "#/$defs/stableKey" },
        "basis_source_key": { "anyOf": [{ "$ref": "#/$defs/stableKey" }, { "type": "null" }] },
        "role": { "enum": ["occurrence", "target", "discovery", "recovery", "arrest", "search", "procedural", "other"] },
        "municipality": { "type": "string", "minLength": 1 },
        "evidence_basis": {
          "enum": ["source_stated_exact", "source_stated_named_site", "source_stated_street", "source_stated_neighbourhood", "source_stated_locality", "geocoder_candidate", "editorial_inference", "unknown"]
        },
        "evidence_precision": { "$ref": "#/$defs/geoPrecision" },
        "resolved_precision": { "$ref": "#/$defs/geoPrecision" },
        "sensitivity": { "enum": ["public_place", "non_sensitive", "private_or_sensitive", "unknown"] },
        "publication_risk": {
          "enum": ["low_public_site", "non_sensitive", "residential", "victim_linked", "minor_or_vulnerable", "sexual_offence_context", "unknown"]
        },
        "geometry": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "coordinates"],
              "properties": {
                "type": { "const": "Point" },
                "coordinates": {
                  "type": "array",
                  "prefixItems": [
                    { "type": "number", "minimum": -180, "maximum": 180 },
                    { "type": "number", "minimum": -90, "maximum": 90 }
                  ],
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          ]
        },
        "place_name": { "type": ["string", "null"] },
        "neighbourhood": { "type": ["string", "null"] },
        "iccs_location_type": { "type": ["string", "null"] }
      }
    },
    "geoPrecision": {
      "enum": ["exact_public_site", "exact_address", "street_segment", "neighbourhood", "locality", "municipality", "unknown"]
    }
  }
}
